// harness.components.address — an international address form whose SHAPE
// is chosen by the country. Pick a country and the server re-renders the
// field set: US wants State + ZIP, the UK a free-text County + postcode,
// Japan leads with a 〒 postal code and a Prefecture and runs large-to-
// small, Germany pairs a PLZ with the city. This is the Datastar move —
// the layout decision lives on the server; the client just asks.
//
// Meant to sit an inch below the card's number/expiry/CVV in a checkout,
// but mounted alone here as its own rectangle.
//
// Signals:  addr.country, and one signal per field (addr.line1, addr.city,
//           addr.region, addr.postcode). Lowercase — the DOM lowercases
//           attribute names.
// Endpoints:
//   GET  /c/address            the form
//   POST /c/address/country    country changed — re-render the field set
//   POST /c/address/submit     validate the postcode for the chosen country

import contrib.tinyweb
import std.string
import std.list
import std.json
import datastar
import harness.page
import harness.components.address.spec
import harness.components.address.validate

exports(mount, fragment, PATH)

const PATH = "/c/address"

mount(_ctx: ptr) {
    tinyweb.end_point(_ctx, tinyweb.GET, PATH) | req: ptr, res: ptr, ctx: ptr | {
        tinyweb.response_set_header(res, "Content-Type", "text/html; charset=utf-8")
        tinyweb.response_write(res, page.wrap("Address component", fragment()))
    }
    tinyweb.end_point(_ctx, tinyweb.POST, "${PATH}/country") | req: ptr, res: ptr, ctx: ptr | {
        country_ep(req, res)
    }
    tinyweb.end_point(_ctx, tinyweb.POST, "${PATH}/submit") | req: ptr, res: ptr, ctx: ptr | {
        submit(req, res)
    }
}

// The whole component: a country <select> that re-renders the fields on
// change, the field region (server-rendered, defaulting to US), and a
// submit + status line.
fragment() -> string {
    return "<div id=\"address-component\" data-signals=\"{addr:{country:'US',line1:'',city:'',region:'',postcode:''},status:'idle',message:''}\">
  ${form_styles()}
  <h2>Shipping address</h2>
  <label for=\"address-country\">Country</label>
  <select id=\"address-country\" data-bind:addr.country=\"\" data-on:change=\"@post('${PATH}/country')\">
    ${country_options()}
  </select>

  <div id=\"address-fields\">
    ${render_fields("US")}
  </div>

  <button id=\"address-submit\" data-on:click=\"@post('${PATH}/submit')\">Save address</button>
  <p id=\"address-status\" data-text=\"\$status\"></p>
  <p id=\"address-message\" data-text=\"\$message\"></p>
</div>"
}

fn country_options() -> string {
    cs = spec.countries()
    out = ""
    n = list.size(cs)
    for (i = 0; i < n; i++) {
        cc, _ = list.get(cs, i)
        out = "${out}<option value=\"${cc}\">${spec.country_name(cc)}</option>\n"
    }
    list.free(cs)
    return out
}

// Render the ordered field set for a country. A region field becomes a
// <select> where the country has canonical regions, else a text input;
// a postcode field carries the country's format hint as its placeholder.
fn render_fields(cc: string) -> string {
    fields = spec.fields(cc)
    out = ""
    n = list.size(fields)
    for (i = 0; i < n; i++) {
        row, _ = list.get(fields, i)
        key = field_part(row, 0)
        label = field_part(row, 1)
        kind = field_part(row, 2)
        id = "address-${key}"
        out = "${out}<label for=\"${id}\">${label}</label>\n"
        if kind == "region" && spec.has_regions(cc) == 1 {
            out = "${out}<select id=\"${id}\" data-bind:addr.${key}=\"\">\n${region_options(cc)}</select>\n"
        } else if kind == "postcode" {
            out = "${out}<input id=\"${id}\" data-bind:addr.${key}=\"\" placeholder=\"${spec.postcode_hint(cc)}\" autocomplete=\"off\">\n"
        } else {
            out = "${out}<input id=\"${id}\" data-bind:addr.${key}=\"\" autocomplete=\"off\">\n"
        }
    }
    list.free(fields)
    return out
}

fn region_options(cc: string) -> string {
    rs = spec.regions(cc)
    out = "<option value=\"\">—</option>\n"
    n = list.size(rs)
    for (i = 0; i < n; i++) {
        row, _ = list.get(rs, i)
        code = field_part(row, 0)
        name = field_part(row, 1)
        out = "${out}<option value=\"${code}\">${name}</option>\n"
    }
    list.free(rs)
    return out
}

// The i-th "|"-separated part of a spec row.
fn field_part(row: string, idx: int) -> string {
    start = 0
    seen = 0
    n = string.length(row)
    for (i = 0; i <= n; i++) {
        at_sep = 0
        if i == n { at_sep = 1 } else { if string.char_at(row, i) == 124 { at_sep = 1 } }
        if at_sep == 1 {
            if seen == idx { return string.substring(row, start, i) }
            seen = seen + 1
            start = i + 1
        }
    }
    return ""
}

// --- endpoints -------------------------------------------------------------

fn addr_str(signals: ptr, key: string) -> string {
    if signals == null { return "" }
    a, _ = json.object_get(signals, "addr")
    if a == null { return "" }
    v, _ = json.object_get(a, key)
    if v == null { return "" }
    if json.json_type(v) == 3 {
        s, err = json.get_string(v)
        if err != "" { return "" }
        return s
    }
    return ""
}

// POST /country — the country changed; patch the field region with that
// country's field set. This is the showcase: one round trip re-lays-out
// the form, and the client wrote nothing but a country code.
fn country_ep(req: ptr, res: ptr) {
    signals, serr = datastar.read_signals(req)
    cc = "US"
    if serr == "" { c = addr_str(signals, "country"); if c != "" { cc = c } }
    if signals != null { json.json_free(signals) }

    sse, err = datastar.new_sse(res)
    if err != "" { return }
    defer datastar.sse_close(sse)
    // Re-render the field region, and clear the outcome line.
    _e = datastar.patch_elements_with(sse,
        "<div id=\"address-fields\">${render_fields(cc)}</div>") {
        datastar.with_selector("#address-fields")
        datastar.with_mode_outer()
    }
    _s = datastar.patch_signals(sse, "{\"status\":\"idle\",\"message\":\"\"}", null)
}

// POST /submit — validate the postcode for the chosen country. The other
// fields are free text; the postcode is the rule worth showing caught.
fn submit(req: ptr, res: ptr) {
    signals, serr = datastar.read_signals(req)
    cc = "US"
    postcode = ""
    if serr == "" {
        c = addr_str(signals, "country"); if c != "" { cc = c }
        postcode = addr_str(signals, "postcode")
    }
    if signals != null { json.json_free(signals) }

    sse, err = datastar.new_sse(res)
    if err != "" { return }
    defer datastar.sse_close(sse)

    verr = validate.postcode(cc, postcode)
    if verr != "" {
        _e = datastar.patch_signals(sse,
            "{\"status\":\"invalid\",\"message\":${datastar.json_quote(verr)}}", null)
        return
    }
    _e = datastar.patch_signals(sse,
        "{\"status\":\"saved\",\"message\":${datastar.json_quote("Address saved for ${spec.country_name(cc)}")}}", null)
}

fn form_styles() -> string {
    return "<style>${form_css()}</style>"
}

fn form_css() -> string {
    return <<CSS
    #address-component {
        max-width: 430px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-family: system-ui, sans-serif;
    }
    #address-component label {
        font-size: 13px;
        color: #33475b;
        margin-top: 8px;
    }
    #address-component input, #address-component select {
        padding: 9px 11px;
        border: 1px solid #c3ccd6;
        border-radius: 7px;
        font-size: 15px;
    }
    #address-component input:focus, #address-component select:focus {
        outline: none;
        border-color: #1e3a5f;
        box-shadow: 0 0 0 3px rgba(30, 58, 95, 0.15);
    }
    #address-submit {
        margin-top: 16px;
        padding: 11px;
        border: 0;
        border-radius: 7px;
        background: #1e3a5f;
        color: #fff;
        font-size: 15px;
        cursor: pointer;
    }
    #address-status { font-weight: 600; margin: 12px 0 0; }
    #address-message { color: #b23; margin: 2px 0 0; }
    CSS
}

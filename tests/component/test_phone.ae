// Component tests for the international phone field. The length rules are
// pinned offline in tests/test_phone.ae (against the generated
// libphonenumber metadata); these prove the browser behaviour — the
// calling code and placeholder track the country, and a number of the
// wrong length for the chosen country is caught on submit.

import std.spec
import std.string
import harness_fixture
import wd_extra
import webdriver

const PHONE_URL = "http://127.0.0.1:4321/c/phone"

main() {
    d = harness_fixture.open_browser()
    stop = harness_fixture.require_browser(d)
    if stop != "" {
        harness_fixture.close_browser(d)
        fw = spec.init()
        _s = spec.skip_all_if(fw, 1, stop)
        if harness_fixture.strict_mode() == 1 { return 1 }
        return 0
    }
    rc = run(d)
    harness_fixture.close_browser(d)
    return rc
}

fn fresh(d: ptr) {
    harness_fixture.reset()
    webdriver.get(d, PHONE_URL)
}

fn pick_country(d: ptr, cc: string) {
    _s = webdriver.execute_script(d,
        "const s=document.getElementById('phone-country'); s.value='${cc}'; s.dispatchEvent(new Event('change')); return 'ok';", "[]")
}

fn run(d: ptr) -> int {
    fw = spec.init()

    spec.describe(fw, "phone — the calling code tracks the country") {
        spec.before_each() callback { fresh(d) }

        spec.it("US shows +1") callback {
            spec.assert_eq(harness_fixture.wait_text(d, "phone-code", "+1", 3000), 1, "US code +1")
        }
        spec.it("switching to the UK shows +44") callback {
            pick_country(d, "GB")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-code", "+44", 3000), 1, "GB code +44")
        }
        spec.it("Japan shows +81") callback {
            pick_country(d, "JP")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-code", "+81", 3000), 1, "JP code +81")
        }
        spec.it("India shows +91") callback {
            pick_country(d, "IN")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-code", "+91", 3000), 1, "IN code +91")
        }
    }

    spec.describe(fw, "phone — length is validated for the chosen country") {
        spec.before_each() callback { fresh(d) }

        spec.it("a valid US number saves") callback {
            _f = wd_extra.set_signals(d, "{\"phone-national\":\"2015550123\"}")
            harness_fixture.click(d, "phone-submit")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-status", "saved", 3000), 1, "10-digit US saved")
        }
        spec.it("a too-short US number is caught") callback {
            _f = wd_extra.set_signals(d, "{\"phone-national\":\"20155\"}")
            harness_fixture.click(d, "phone-submit")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-message", "wrong length", 3000), 1, "short US rejected")
        }
        spec.it("a number valid for the US can be wrong for another country") callback {
            // 2015550123 is a fine 10-digit US number. France wants 9 —
            // pick FR, enter the same 10 digits, and it must be rejected.
            pick_country(d, "FR")
            sleep(500)
            _f = wd_extra.set_signals(d, "{\"phone-national\":\"2015550123\"}")
            harness_fixture.click(d, "phone-submit")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-message", "Not a possible FR", 3000), 1, "10 digits wrong for FR")
        }
        spec.it("the same digits are accepted once the country matches") callback {
            // France wants 9 digits; a 9-digit number saves.
            pick_country(d, "FR")
            sleep(500)
            _f = wd_extra.set_signals(d, "{\"phone-national\":\"123456789\"}")
            harness_fixture.click(d, "phone-submit")
            spec.assert_eq(harness_fixture.wait_text(d, "phone-status", "saved", 3000), 1, "9-digit FR saved")
        }
    }

    return spec.run_summary(fw)
}

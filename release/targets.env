# Release build matrix — the platforms the cmd/ binaries are cross-built for.
#
# Everything here is pure Aether, so all of these cross-compile from a single
# Linux host via `ae build --target` (zig cc backend) — no per-OS runner. Each
# maps to an executable suffix:
#   *-linux    -> (none)   ELF, glibc (carries a GLIBC floor)
#   *-linux-musl -> (none) ELF, static
#   *-macos    -> (none)   Mach-O
#   *-windows  -> .exe     PE   [slower mingw cross; opt-in]
#   *-freebsd  -> (none)   ELF  [needs AETHER_SYSROOT; opt-in]

# Core matrix: no sysroot, fast, always built.
RELEASE_TARGETS="aarch64-linux x86_64-linux aarch64-linux-musl x86_64-linux-musl aarch64-macos x86_64-macos"

# Opt-in extras (RELEASE_EXTRA_TARGETS=1 to include). Windows cross is slow;
# FreeBSD needs AETHER_SYSROOT set.
RELEASE_EXTRA_TARGETS_LIST="x86_64-windows aarch64-windows x86_64-freebsd"
